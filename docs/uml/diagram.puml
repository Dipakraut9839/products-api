@startuml
class Product {
- id : Long
- name : String
- price : double
+ Product()
+ Product(id : Long, name : String, price : double)
+ getId() : Long
+ getName() : String
+ getPrice() : double
}
class Customer {
- id : Long
- name : String
- email : String
- address : Address
+ Customer()
+ Customer(id : Long, name : String, email : String, address : Address)
+ getId() : Long
+ getName() : String
+ getEmail() : String
+ getAddress() : Address
}
class Address {
- street : String
- city : String
- postcode : String
+ Address()
+ Address(street : String, city : String, postcode : String)
+ getStreet() : String
+ getCity() : String
+ getPostcode() : String
}
Customer --> Address

class Product {
- id : Long
- name : String
- price : double
+ getId() : Long
+ getName() : String
+ getPrice() : double
+ setId(id : Long) : void
+ setName(name : String) : void
+ setPrice(price : double) : void
}
class ProductService {
- products : List<Product>
- nextId : Long
+ getAllProducts() : List<Product>
+ getProductById(id : Long) : Optional<Product>
+ addProduct(product : Product) : Product
+ deleteProduct(id : Long) : void
+ findByName(name : String) : List<Product>
}
class ProductController {
- productService : ProductService
+ getAllProducts() : List<Product>
+ getProductById(id : Long) : Product
+ addProduct(product : Product) : Product
+ deleteProduct(id : Long) : void
}
' ..> is a dependency: DASHED line, open arrow
ProductController ..> ProductService
' --> is an association: SOLID line
ProductService --> Product
@enduml